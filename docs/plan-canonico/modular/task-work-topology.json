{
  "schema_version": 2,
  "policy_id": "CANONICAL-TASK-WORK-TOPOLOGY-001",
  "canonical_marker_semantics": "DEFINE_CONTRACT_ONCE",
  "instance_separator": "::",
  "coverage_policy": "ALL_CONTINUITY_TASKS_EXACTLY_ONCE",
  "mode_definitions": {
    "DEFINE_ONCE": {
      "label": "Definir una sola vez sin instancia física propia",
      "canonical_work": "El marcador canónico se desarrolla y aprueba una sola vez como contrato reutilizable.",
      "execution_dependencies": "No crea una instancia física propia.",
      "execution_rule": "Los consumidores reutilizan el contrato aprobado sin repetir esta tarea como ejecución.",
      "instance_pattern": "<task_id>"
    },
    "GLOBAL_ENABLE_ONCE": {
      "label": "Una instancia física global reutilizable",
      "canonical_work": "El marcador canónico define una sola vez el contrato de una fundación compartida.",
      "execution_dependencies": "Las dependencias temporales se resuelven exclusivamente mediante execution_gate.",
      "execution_rule": "Existe como máximo una instancia física global reutilizable por todos los paquetes aplicables.",
      "instance_pattern": "<task_id>::GLOBAL"
    },
    "TEMPLATE_PER_PACKAGE": {
      "label": "Una instancia por package_id",
      "canonical_work": "El marcador canónico define una sola vez la plantilla o contrato repetible por paquete.",
      "execution_dependencies": "Las dependencias temporales se resuelven exclusivamente mediante execution_gate.",
      "execution_rule": "Cada package_id aplicable registra su propia instancia sin reabrir el marcador global.",
      "instance_pattern": "<task_id>::<package_id>"
    },
    "PER_IMPLEMENTATION_UNIT": {
      "label": "Una instancia por implementation_unit_id",
      "canonical_work": "El marcador canónico define una sola vez el contrato de una unidad física reutilizable.",
      "execution_dependencies": "Las dependencias temporales se resuelven exclusivamente mediante execution_gate.",
      "execution_rule": "Cada implementation_unit_id se materializa como máximo una vez y puede ser consumido por varios package_id mediante lineage.",
      "instance_pattern": "<task_id>::<implementation_unit_id>"
    },
    "PER_PACKAGE_AND_GLOBAL_FINAL": {
      "label": "Instancia por paquete y certificación global final",
      "canonical_work": "El marcador canónico define una sola vez el contrato de certificación.",
      "execution_dependencies": "Las dependencias temporales se resuelven exclusivamente mediante execution_gate.",
      "execution_rule": "Se registra una ejecución por package_id y una certificación GLOBAL-FINAL agregada cuando corresponda.",
      "instance_pattern": "<task_id>::<package_id> + <task_id>::GLOBAL-FINAL"
    },
    "GLOBAL_FINAL": {
      "label": "Una certificación global final",
      "canonical_work": "El marcador canónico define una sola vez el cierre transversal.",
      "execution_dependencies": "Las dependencias temporales se resuelven exclusivamente mediante execution_gate.",
      "execution_rule": "Se materializa una sola instancia GLOBAL-FINAL cuando sus prerrequisitos estén cerrados.",
      "instance_pattern": "<task_id>::GLOBAL-FINAL"
    }
  },
