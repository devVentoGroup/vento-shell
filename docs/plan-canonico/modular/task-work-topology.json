  "execution_gate_definitions": {
    "NO_PHYSICAL_INSTANCE": {
      "label": "Sin instancia física propia",
      "rule": "La tarea se agota en su contrato canónico y no genera una ejecución física identificable."
    },
    "PRE_E5_PLANNING": {
      "label": "Planificación por paquete anterior a la puerta E5",
      "rule": "La instancia construye o cierra el expediente del package_id antes de E5-GATE-008; E5-GATE-008 es resultado de este carril y nunca su prerrequisito."
    },
    "PRE_E5_FOUNDATION": {
      "label": "Fundación transversal materializable antes de E5",
      "rule": "La instancia puede materializarse antes de E5 después de aprobar su contrato, satisfacer sus dependencias técnicas y recibir autorización física explícita. No constituye implementación vertical de un package_id."
    },
    "POST_E5_PACKAGE": {
      "label": "Ejecución física posterior a E5 del paquete propietario",
      "rule": "La instancia requiere el package_id propietario aplicable y E5-GATE-008::<package_id> = PASS antes de ejecutar cambios físicos."
    },
    "UNREVIEWED": {
      "label": "Gate temporal todavía no revisado",
      "rule": "La reconciliación integral todavía no ha clasificado esta tarea. Este valor nunca relaja ni sustituye su contrato histórico y no concede autorización temporal nueva."
    }
  },
