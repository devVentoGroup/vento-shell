{
  "name": "vento-shell",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate-favicon": "node scripts/generate-favicon.mjs",
    "docs:plan:build": "node scripts/docs/build-plan-canonico.mjs",
    "docs:plan:check": "node scripts/docs/build-plan-canonico-core.mjs --check",
    "docs:plan:organize": "node scripts/docs/reorganize-plan-by-logical-blocks.mjs",
    "docs:plan:organize:apply": "node scripts/docs/reorganize-plan-by-logical-blocks.mjs --apply",
    "docs:plan:test": "node --test scripts/docs/plan-continuity-global.test.mjs scripts/docs/validate-process-application-integrity.test.mjs scripts/docs/validate-screen-catalog.test.mjs scripts/docs/validate-screen-process-bindings.test.mjs scripts/docs/validate-screen-contract-matrices.test.mjs",
    "docs:process-apps:check": "node scripts/docs/validate-process-application-integrity.mjs",
    "docs:screens:check": "node scripts/docs/validate-screen-catalog.mjs",
    "docs:screen-processes:check": "node scripts/docs/validate-screen-process-bindings.mjs",
    "docs:screen-matrices:check": "node scripts/docs/validate-screen-contract-matrices.mjs",
    "docs:treq:check": "node scripts/docs/validate-treq-registry.mjs",
    "docs:treq:test": "node --test scripts/docs/validate-treq-registry.test.mjs scripts/docs/treq-safe-reconcile.test.mjs",
    "docs:plan:watch": "node scripts/docs/watch-plan-canonico.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "supabase": "^2.109.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "png-to-ico": "^2.1.3",
    "sharp": "^0.33.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
