{
  "name": "vento-shell",
  "version": "0.1.0",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "generate-favicon": "node scripts/generate-favicon.mjs",
    "docs:plan:build": "node scripts/docs/build-plan-canonico.mjs",
    "docs:plan:check": "node scripts/docs/auto-prepare-canonical-task.mjs --check && node scripts/docs/validate-task-delivery.mjs && node scripts/docs/build-plan-canonico-core.mjs --check && node scripts/docs/sync-pending-task-context.mjs --check && node scripts/docs/normalize-retired-priority-route.mjs --check && node scripts/docs/validate-print-process-bindings.mjs",
    "docs:plan:organize": "node scripts/docs/reorganize-plan-by-logical-blocks.mjs",
    "docs:plan:organize:apply": "node scripts/docs/reorganize-plan-by-logical-blocks.mjs --apply",
    "docs:plan:test": "node --test scripts/docs/execution-route.test.mjs scripts/docs/execution-route-deferral.test.mjs scripts/docs/plan-continuity-global.test.mjs scripts/docs/sync-pending-task-context.test.mjs scripts/docs/validate-canonical-plan-workflow.test.mjs scripts/docs/validate-e3-transition-closure.test.mjs scripts/docs/validate-process-application-integrity.test.mjs scripts/docs/validate-screen-catalog.test.mjs scripts/docs/validate-screen-process-bindings.test.mjs scripts/docs/validate-screen-contract-matrices.test.mjs scripts/docs/validate-block-i-surface-matrices.test.mjs scripts/docs/validate-priority-delivery-lanes.test.mjs scripts/docs/validate-event-application-block.test.mjs scripts/docs/validate-external-credential-taxonomy.test.mjs scripts/docs/validate-print-process-bindings.test.mjs scripts/docs/validate-task-delivery.test.mjs scripts/docs/format-canonical-task.test.mjs scripts/docs/task-format-policy.test.mjs scripts/docs/canonical-task-preflight.test.mjs scripts/docs/auto-prepare-canonical-task.test.mjs scripts/docs/plan-watch-runtime.test.mjs scripts/docs/repository-drift.test.mjs",
    "docs:process-apps:check": "node scripts/docs/validate-process-application-integrity.mjs",
    "docs:screens:check": "node scripts/docs/validate-screen-catalog.mjs",
    "docs:screen-processes:check": "node scripts/docs/validate-screen-process-bindings.mjs",
    "docs:screen-matrices:check": "node scripts/docs/validate-screen-contract-matrices.mjs",
    "docs:block-i:reconcile": "node scripts/docs/reconcile-block-i-surface-matrices.mjs && node scripts/docs/reconcile-block-i-treq-registry.mjs",
    "docs:block-i:check": "node scripts/docs/validate-block-i-surface-matrices.mjs",
    "docs:auth-ui-031:check": "node scripts/docs/build-auth-ui-031-proposal.mjs --check",
    "docs:delivery-lanes:check": "node scripts/docs/validate-priority-delivery-lanes.mjs",
    "docs:delivery-lanes:sync": "node scripts/docs/sync-priority-delivery-lanes-doc.mjs",
    "docs:int-app:check": "node scripts/docs/validate-event-application-block.mjs",
    "docs:int-ext:check": "node scripts/docs/validate-external-credential-taxonomy.mjs",
    "docs:print-processes:check": "node scripts/docs/validate-print-process-bindings.mjs",
    "docs:delivery:check": "node scripts/docs/validate-task-delivery.mjs",
    "docs:task:preflight": "node scripts/docs/canonical-task-preflight.mjs",
    "docs:task:format": "node scripts/docs/format-canonical-task.mjs",
    "docs:task:auto": "node scripts/docs/auto-prepare-canonical-task.mjs",
    "docs:task:policy:check": "node scripts/docs/task-format-policy.mjs",
    "docs:repos:drift": "node scripts/docs/repository-drift.mjs",
    "docs:treq:check": "node scripts/docs/validate-treq-registry.mjs",
    "docs:treq:test": "node --test scripts/docs/validate-treq-registry.test.mjs scripts/docs/treq-safe-reconcile.test.mjs",
    "docs:plan:watch": "node scripts/docs/watch-plan-canonico.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.90.1",
    "next": "16.1.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "supabase": "^2.109.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "png-to-ico": "^2.1.8",
    "sharp": "^0.33.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
