.gitattributes text eol=lf
.editorconfig text eol=lf
.vscode/*.json text eol=lf
# Mantener estable el formato de las fuentes y herramientas del plan canónico.
docs/plan-canonico/modular/** text eol=lf
# El compilado replica saltos Markdown significativos de las fuentes; no tratar
# sus dos espacios finales como errores de whitespace del artefacto generado.
docs/plan-canonico/modular/.generated/*.md whitespace=-blank-at-eol
scripts/docs/** text eol=lf
package.json text eol=lf
# Los contratos de autorización deben ser byte-estables entre Windows y CI/Linux.
packages/contracts/authorization/**/*.json text eol=lf
packages/contracts/authorization/**/*.jsonl text eol=lf
packages/contracts/authorization/**/*.ts text eol=lf
packages/contracts/authorization/**/*.mjs text eol=lf
packages/contracts/authorization/**/*.md text eol=lf
