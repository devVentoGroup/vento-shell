{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.vento.local/authorization/permission.schema.json",
  "title": "Vento Authorization Permission Identity",
  "description": "Pre-publication identity slice materialized by SHELL-CON-003::GLOBAL. Full permission metadata remains owned by later contract tasks.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "permission_key",
    "app_code",
    "lifecycle_status"
  ],
  "properties": {
    "permission_key": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(?:\\.access|(?:\\.[a-z][a-z0-9_]*){3})$"
    },
    "app_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "retired",
        "reserved"
      ]
    }
  }
}