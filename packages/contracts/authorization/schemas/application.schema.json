{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.vento.local/authorization/application.schema.json",
  "title": "Vento Authorization Application",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "app_code",
    "display_name",
    "app_kind",
    "domain",
    "roadmap_scope",
    "lifecycle_status",
    "permission_namespace",
    "is_authorization_catalog_member"
  ],
  "properties": {
    "app_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "app_kind": {
      "type": "string",
      "enum": [
        "hub",
        "administrative",
        "operational",
        "hybrid",
        "customer"
      ]
    },
    "domain": {
      "type": "string",
      "enum": [
        "laboral",
        "cliente"
      ]
    },
    "roadmap_scope": {
      "type": "string",
      "enum": [
        "core",
        "deferred",
        "adjacent"
      ]
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "active",
        "deprecated",
        "retired",
        "reserved"
      ]
    },
    "repository_owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "permission_namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "is_authorization_catalog_member": {
      "type": "boolean"
    }
  }
}